# GitHub token: reads PRs, reviews and checks. Quick bootstrap: gh auth token — better, a dedicated
# token. Approving from the dashboard needs a token allowed to review (classic PAT with `repo`, or a
# fine-grained one with Pull requests: read & write).
GITHUB_TOKEN=

# VAPID keys for Web Push notifications. Generate them with:
#   docker compose run --rm sentinel python gen_vapid.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=you@example.com

# Timezone used for local time display and "snooze until tomorrow 9am" (default: UTC)
TZ=UTC

# Optional: Claude — reviews on demand, dependency bump checks and post-merge investigations.
# Runs contrib/claude-bridge on the host (Claude Code lives there, not in the container).
# Leave empty to turn every Claude feature off.
# CLAUDE_BRIDGE_URL=http://host.docker.internal:8301

# Optional: Cycle tab (big rocks from a Slite note + Shortcut epic progress).
# Both are required for the tab to show up; see the `cycle:` block in config.yaml.
# SLITE_API_KEY=
# SHORTCUT_API_TOKEN=

# Optional: never push (a second instance running on a copy of the database)
# SENTINEL_PUSH_DISABLED=1
