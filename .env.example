# GitHub token, used to list PRs waiting for your review.
# Quick bootstrap: gh auth token — or better, a dedicated fine-grained PAT with
# read-only Pull Request access to your orgs. The optional "Approve" button on the
# dashboard requires a classic PAT with the `repo` scope.
GITHUB_TOKEN=

# VAPID keys for Web Push notifications. Generate them with:
#   docker compose run --rm sentinel python gen_vapid.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=you@example.com

# Timezone used for local time display and "snooze until tomorrow 9am" (default: UTC)
TZ=UTC

# Optional: "Ask Claude" button on the PR panel. Runs contrib/claude-bridge on the host
# (Claude Code lives there, not in the container). Leave empty to hide the button.
# CLAUDE_BRIDGE_URL=http://host.docker.internal:8301
